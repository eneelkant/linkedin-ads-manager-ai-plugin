# LinkedIn Ads Manager MCP — placeholders only. Never commit real secrets.

# Required for campaign management (Marketing Developer Platform)
# Scopes: rw_ads, r_ads_reporting
LINKEDIN_CAMPAIGNS_TOKEN=

# Required numeric LinkedIn ad account ID
LINKEDIN_ACCOUNT_ID=

# Optional — organization posting only (Community Management API)
# Scope: w_organization_social
# Not required for Ads campaign management.
LINKEDIN_POSTS_TOKEN=

# Optional remote MCP HTTP bearer token (recommended for public deployments)
# MCP_HTTP_BEARER_TOKEN=

# Optional: allow non-high-risk writes without confirm=true
# High-risk tools (budget/targeting/pause/resume/create/clone/post) always require confirm=true
# LINKEDIN_TRUSTED_EXECUTION=false

# Optional HTTP settings
# PORT=3000
# ALLOWED_HOSTS=your-domain.example.com
# MCP_TRANSPORT=http
# LOG_LEVEL=info
